{%- comment -%}
  FIX (revamp): real, crawlable counterpart to the "Find Your Escent" quiz
  modal in sections/header.liquid. Both read the same live product tags, so
  a product only ever shows up here while it's active and tagged for a
  family -- nothing hardcoded, nothing that can point at an archived
  product. This closes the "give Find My Escent a real indexable URL"
  audit item, since the modal alone is not crawlable by search engines.

  Family membership rules (kept in sync with the JSON block in
  sections/header.liquid):
    Woody & Oud      -> tags contain 'woody' or 'oud'
    Citrus & Fresh   -> tags contain 'citrus' or 'fresh'
    Gourmand & Floral -> tags contain 'floral', 'gourmand', 'sweet',
                          'fruity', or 'oudh'
  A product can appear under more than one family if it genuinely has tags
  in both (e.g. a woody citrus scent) -- this is intentional, not a bug.
{%- endcomment -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .find-my-escent-section {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .find-my-escent-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .find-my-escent-family {
    margin-bottom: 3rem;
  }

  .find-my-escent-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .find-my-escent-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .find-my-escent-card {
    position: relative;
    display: block;
    text-align: center;
  }

  .find-my-escent-card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 16px;
  }

  .find-my-escent-card.is-sold-out img {
    opacity: 0.6;
  }

  .find-my-escent-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-size: 1rem;
    padding: 0.2rem 0.8rem;
    border-radius: 8px;
  }
{%- endstyle -%}

<div class="find-my-escent-section page-width">
  <h1 class="page-title">{{ page.title }}</h1>
  {%- if page.content != blank -%}
    <div class="rte">{{ page.content }}</div>
  {%- endif -%}

  {%- comment -%} Woody & Oud {%- endcomment -%}
  <div class="find-my-escent-family">
    <h2>Woody &amp; Oud</h2>
    <div class="find-my-escent-grid">
      {%- assign woody_count = 0 -%}
      {%- for product in collections.all.products -%}
        {%- if product.available -%}
          {%- if product.tags contains 'woody' or product.tags contains 'oud' -%}
            {%- assign woody_count = woody_count | plus: 1 -%}
            <a href="{{ product.url }}" class="find-my-escent-card">
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
              <p>{{ product.title }}</p>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- for product in collections.all.products -%}
        {%- unless product.available -%}
          {%- if product.tags contains 'woody' or product.tags contains 'oud' -%}
            {%- assign woody_count = woody_count | plus: 1 -%}
            <a href="{{ product.url }}" class="find-my-escent-card is-sold-out">
              <span class="find-my-escent-badge">{{ 'products.product.sold_out' | t }}</span>
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
              <p>{{ product.title }}</p>
            </a>
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
    {%- if woody_count == 0 -%}
      <p>Nothing in this family right now — check back soon!</p>
    {%- endif -%}
  </div>

  {%- comment -%} Citrus & Fresh {%- endcomment -%}
  <div class="find-my-escent-family">
    <h2>Citrus &amp; Fresh</h2>
    <div class="find-my-escent-grid">
      {%- assign citrus_count = 0 -%}
      {%- for product in collections.all.products -%}
        {%- if product.available -%}
          {%- if product.tags contains 'citrus' or product.tags contains 'fresh' -%}
            {%- assign citrus_count = citrus_count | plus: 1 -%}
            <a href="{{ product.url }}" class="find-my-escent-card">
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
              <p>{{ product.title }}</p>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- for product in collections.all.products -%}
        {%- unless product.available -%}
          {%- if product.tags contains 'citrus' or product.tags contains 'fresh' -%}
            {%- assign citrus_count = citrus_count | plus: 1 -%}
            <a href="{{ product.url }}" class="find-my-escent-card is-sold-out">
              <span class="find-my-escent-badge">{{ 'products.product.sold_out' | t }}</span>
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
              <p>{{ product.title }}</p>
            </a>
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
    {%- if citrus_count == 0 -%}
      <p>Nothing in this family right now — check back soon!</p>
    {%- endif -%}
  </div>

  {%- comment -%} Gourmand & Floral {%- endcomment -%}
  <div class="find-my-escent-family">
    <h2>Gourmand &amp; Floral</h2>
    <div class="find-my-escent-grid">
      {%- assign floral_count = 0 -%}
      {%- for product in collections.all.products -%}
        {%- if product.available -%}
          {%- if product.tags contains 'floral' or product.tags contains 'gourmand' or product.tags contains 'sweet' or product.tags contains 'fruity' or product.tags contains 'oudh' -%}
            {%- assign floral_count = floral_count | plus: 1 -%}
            <a href="{{ product.url }}" class="find-my-escent-card">
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
              <p>{{ product.title }}</p>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- for product in collections.all.products -%}
        {%- unless product.available -%}
          {%- if product.tags contains 'floral' or product.tags contains 'gourmand' or product.tags contains 'sweet' or product.tags contains 'fruity' or product.tags contains 'oudh' -%}
            {%- assign floral_count = floral_count | plus: 1 -%}
            <a href="{{ product.url }}" class="find-my-escent-card is-sold-out">
              <span class="find-my-escent-badge">{{ 'products.product.sold_out' | t }}</span>
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
              <p>{{ product.title }}</p>
            </a>
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
    {%- if floral_count == 0 -%}
      <p>Nothing in this family right now — check back soon!</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Find My Escent",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}