{% doc %}
  @prompt
    CART CHECKBOX
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cart-checkbox-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
  }

  .ai-cart-checkbox__label-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    color: {{ block.settings.text_color }};
    cursor: pointer;
  }

  .ai-cart-checkbox__input-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    margin: 1px 0 0;
    accent-color: {{ block.settings.accent_color }};
    cursor: pointer;
  }

  .ai-cart-checkbox__content-{{ ai_gen_id }} { flex: 1; }
  .ai-cart-checkbox__title-{{ ai_gen_id }} { display: block; font-weight: 600; font-size: 16px; line-height: 1.3; }
  .ai-cart-checkbox__description-{{ ai_gen_id }} { display: block; margin-top: 4px; font-size: 14px; line-height: 1.4; }
  .ai-cart-checkbox__status-{{ ai_gen_id }} { margin: 8px 0 0 32px; font-size: 13px; color: {{ block.settings.status_color }}; }
  .ai-cart-checkbox__status-{{ ai_gen_id }}[hidden] { display: none; }
{% endstyle %}

<cart-option-{{ ai_gen_id }} class="ai-cart-checkbox-{{ ai_gen_id }}" data-variant-id="{% if block.settings.product != blank %}{{ block.settings.product.selected_or_first_available_variant.id }}{% endif %}" {{ block.shopify_attributes }}>
  <label class="ai-cart-checkbox__label-{{ ai_gen_id }}">
    <input class="ai-cart-checkbox__input-{{ ai_gen_id }}" type="checkbox" {% if block.settings.product == blank or block.settings.product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
    <span class="ai-cart-checkbox__content-{{ ai_gen_id }}">
      <span class="ai-cart-checkbox__title-{{ ai_gen_id }}">{{ block.settings.title }}</span>
      <span class="ai-cart-checkbox__description-{{ ai_gen_id }}">{{ block.settings.description }}</span>
    </span>
  </label>
  <p class="ai-cart-checkbox__status-{{ ai_gen_id }}" hidden role="status"></p>
</cart-option-{{ ai_gen_id }}>

<script>
  (() => {
    class CartOption{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.input = this.querySelector('.ai-cart-checkbox__input-{{ ai_gen_id }}');
        this.status = this.querySelector('.ai-cart-checkbox__status-{{ ai_gen_id }}');
        this.variantId = this.dataset.variantId;
        if (!this.input || !this.variantId) return;
        this.input.addEventListener('change', () => this.updateCart());
      }

      async updateCart() {
        this.input.disabled = true;
        this.status.hidden = false;
        this.status.textContent = '{{ block.settings.adding_message | escape }}';
        try {
          const cartResponse = await fetch('/cart.js');
          const cart = await cartResponse.json();
          const line = cart.items.find((item) => String(item.variant_id) === String(this.variantId));
          if (this.input.checked && !line) {
            await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: Number(this.variantId), quantity: 1 }] }) });
          } else if (!this.input.checked && line) {
            await fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: line.key, quantity: 0 }) });
          }
          this.status.textContent = this.input.checked ? '{{ block.settings.added_message | escape }}' : '{{ block.settings.removed_message | escape }}';
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          setTimeout(() => window.location.reload(), 250);
        } catch (error) {
          this.input.checked = !this.input.checked;
          this.status.textContent = '{{ block.settings.error_message | escape }}';
        } finally {
          this.input.disabled = false;
        }
      }
    }
    if (!customElements.get('cart-option-{{ ai_gen_id }}')) customElements.define('cart-option-{{ ai_gen_id }}', CartOption{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Cart checkbox",
  "settings": [
    { "type": "product", "id": "product", "label": "Option product" },
    { "type": "text", "id": "title", "label": "Title", "default": "Add gift wrapping" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Make this order extra special with gift wrapping." },
    { "type": "text", "id": "adding_message", "label": "Loading message", "default": "Updating your cart..." },
    { "type": "text", "id": "added_message", "label": "Added message", "default": "Gift wrapping added." },
    { "type": "text", "id": "removed_message", "label": "Removed message", "default": "Gift wrapping removed." },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "Unable to update your cart. Please try again." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3f3f3" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#d1d1d1" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "accent_color", "label": "Checkbox", "default": "#121212" },
    { "type": "color", "id": "status_color", "label": "Status text", "default": "#454545" },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_top", "label": "Top spacing", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom spacing", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "Cart checkbox" }],
  "tag": null,
  "class": "cart-checkbox-block"
}
{% endschema %}